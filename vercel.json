{
  "rewrites": [
    {
      "source": "/blog/:path*",
      "destination": "/blog/:path*"
    }
  ],
  "headers": [
    {
      "source": "/blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}